{
  "name": "contripact-devpostlearn",
  "version": "0.1.0",
  "private": true,
  "description": "Competition-specific ContriPact proof of concept for Build With AI.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "warm": "tsx scripts/warmDemo.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
